generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform users (Admin, Secretary, Super Admin)
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String?
  otpCode       String?   
  otpExpires    DateTime?
  role          String   @default("USER")
  createdAt     DateTime @default(now())
}

// News articles published on the public site
model Article {
  id            String         @id @default(cuid())
  title         String
  content       String
  coverImageUrl String?
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        ArticlePhoto[]
}

// Photos attached to a specific article
model ArticlePhoto {
  id        String  @id @default(cuid())
  url       String
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// Job offers and training opportunities
model Opportunity {
  id           String        @id @default(cuid())
  type         String        // "JOB" or "TRAINING"
  title        String
  description  String
  deadline     DateTime?
  published    Boolean       @default(false)
  isFree       Boolean       @default(true)  // false = requires payment via FedaPay
  price        Float?                         // price in XOF, null if free
  createdAt    DateTime      @default(now())
  applications Application[]
}

// Applications submitted for an opportunity
model Application {
  id              String      @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fullName        String
  email           String?
  phone           String      // WhatsApp-compatible number preferred
  message         String?
  cvUrl           String?     // optional, mainly used for job offers
  createdAt       DateTime    @default(now())
}
// Annual work plan activities (PTA) with real-time tracking
model PtaActivity {
  id          String   @id @default(cuid())
  year        String
  title       String
  description String
  status      String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  updatedAt   DateTime @updatedAt
}

// Single official PTA PDF document for the entire mandate
model PtaDocument {
  id        String   @id @default(cuid())
  pdfUrl    String
  year      String   // e.g. "2025-2030"
  updatedAt DateTime @updatedAt
}

// Security audit log — tracks login attempts and admin actions
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g. "LOGIN_SUCCESS", "LOGIN_FAILED", "ARTICLE_DELETED"
  userEmail String
  ipAddress String?
  createdAt DateTime @default(now())
}